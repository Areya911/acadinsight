# Server port (Render will inject this automatically)
PORT=5000

# Node environment
NODE_ENV=production

# JWT secret for authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Render Managed PostgreSQL Connection String
DATABASE_URL=postgres://username:password@hostname:5432/dbname

# Enable remote Postgres (set to true on Render when using PostgreSQL)
USE_REMOTE_POSTGRES=true

# Frontend URL (for CORS allowance)
FRONTEND_URL=https://your-frontend-service.onrender.com
